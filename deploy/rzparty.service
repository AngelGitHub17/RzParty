[Unit]
Description=RzParty (party game multijoueur)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rzparty
Group=rzparty
WorkingDirectory=/opt/rzparty
EnvironmentFile=-/etc/rzparty/rzparty.env
ExecStart=/usr/bin/npm run serve
Restart=on-failure
RestartSec=3
# Autorise un port < 1024 (ex. 80) sans être root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
